[
  // Automations control panel: state, runs, logs.
  // ↑↓ navigate, space toggle, x run, l log, e edit, c clear runs, a scheduler, q quit. enter confirms, esc cancels.
  {
    "label": "Automations",
    "command": "python3 automations/cron.py",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
  },
  // One-shot: lists my open PRs in px-center, splitting merge-ready ones from those needing attention
  // (CI, conflicts, pending reviewers and unresolved comments).
  {
    "label": "My PRs",
    "command": "python3 scripts/my-prs.py",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
  },
  // One-shot and idempotent: symlinks assets/ into each tool per tools/*.json.
  // Backs up existing targets as .bkp.
  {
    "label": "Link all tools",
    "command": "bash scripts/link.sh",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
  },
]
