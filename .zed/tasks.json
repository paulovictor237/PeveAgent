[
  // Loop contínuo (a cada 1s): painel das automações — agendador, jobs, o que está rodando e últimas execuções.
  // Só visualiza; não dispara jobs. q sai, r atualiza.
  {
    "label": "Automations watch",
    "command": "python3 automations/peve-auto.py watch",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  // Execução única: lista meus PRs abertos na px-center, separando prontos pra merge dos que precisam de atenção
  // (CI, conflitos, reviewers pendentes e comentários não resolvidos).
  {
    "label": "Meus PRs",
    "command": "clear && python3 ~/.claude/skills/my-prs/my-prs.py",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  // Execução única e idempotente: cria os symlinks de assets/ para as ferramentas conforme tools/Users/paulo.duarte/workspace/outros/PeveAgent/*.json.
  // Faz backup .bkp do que já existir no destino.
  {
    "label": "Link all tools",
    "command": "bash scripts/link.sh",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  }
]
