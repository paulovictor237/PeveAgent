// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_buffer_font_size": 16.0,
  "agent_ui_font_size": 18.0,
  "edit_predictions": {
    "provider": "zed"
  },
  "format_on_save": "on",
  "code_actions_on_format": {
    "source.removeUnusedImports": true,
    "source.addMissingImports": true,
    "source.fixAll.eslint": true
    // "source.organizeImports": true,
  },
  "languages": {
    "Git Commit": {
      "tab_size": 1
    },
    "PHP": {
      "language_servers": ["intelephense", "!phpactor", "!phptools", "..."]
    }
  },
  "diff_view_style": "split",
  "prettier": {
    "allowed": true
  },
  "git_panel": {
    "sort_by_path": true,
    "tree_view": false
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
      "enable_thinking": false
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
      "enable_thinking": false
    },
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "claude-sonnet-4.6",
        "enable_thinking": false
      }
    ],
    "model_parameters": []
  },
  "context_servers": {
    "Framelink MCP for Figma": {
      "env": {},
      "enabled": true,
      "remote": false,
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp",
        "--figma-api-key=FIGMA_API_KEY_REMOVED",
        "--stdio"
      ]
    }
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Frappé",
    "dark": "Catppuccin Frappé"
  },
  "terminal": {
    "font_size": 16.0,
    "font_family": "FiraCode Nerd Font",
    "option_as_meta": true
  },
  "project_panel": {
    "hide_gitignore": false,
    "auto_fold_dirs": false
  },
  "base_keymap": "VSCode",
  "sticky_scroll": {
    "enabled": false
  },
  "minimap": {
    "show": "never"
  },
  "scrollbar": {
    "axes": {
      "horizontal": true,
      "vertical": true
    }
  },
  "buffer_font_family": "FiraCode Nerd Font",
  "auto_indent_on_paste": false,
  "use_on_type_format": false,
  "use_auto_surround": true,
  "semantic_tokens": "off",
  "wrap_guides": [80, 120],
  "hard_tabs": false,
  "tab_size": 2,
  "ui_font_size": 17.0,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light Hard",
    "dark": "Catppuccin Frappé"
  },
  "experimental.theme_overrides": {
    "syntax": {
      "constant.comment.todo": { "color": "#000", "background_color": "#f00" },
      "property.comment.error": { "color": "#000", "background_color": "#d33" },
      "string.comment.info": { "color": "#000", "background_color": "#17d" },
      "keyword.comment.warn": { "color": "#000", "background_color": "#fa0" }
    }
  }
}
