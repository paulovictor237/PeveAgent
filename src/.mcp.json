{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "figma-context": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "figma-developer-mcp", "--figma-api-key=_key_", "--stdio"]
    }
  },
  "jira": {
    "type": "sse",
    "url": "https://mcp.atlassian.com/v1/sse",
    "enabled": true
  },
  "github": {
    "type": "http",
    "url": "https://api.githubcopilot.com/mcp",
    "headers": { "Authorization": "Bearer ${GITHUB_TOKEN}" },
    "enabled": true
  }
}
