#!/bin/sh

STAGED=$(git diff --cached)
FOUND=0

if echo "$STAGED" | grep -iE '(api[_-]?key|secret|password|token|auth)[^=:\n]{0,10}[=:]\s*["\x27][^"\x27]{8,}'; then
  FOUND=1
fi

if echo "$STAGED" | grep -E '"(sk-|ghp_|gho_|ghs_|xoxb-|xoxp-|xoxa-|AKIA|AIza|ya29\.)[^"\s]{8,}"'; then
  FOUND=1
fi

if echo "$STAGED" | grep -E '\-\-\-\-\-BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY'; then
  FOUND=1
fi

if echo "$STAGED" | grep -iE 'https?://[^:@\s]+:[^:@\s]+@[a-zA-Z0-9]'; then
  FOUND=1
fi

if [ "$FOUND" -eq 1 ]; then
  echo ""
  echo "ERRO: possível chave de API detectada no commit. Remova antes de continuar."
  exit 1
fi
