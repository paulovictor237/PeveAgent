{
  "permissions": {
    "allow": [
      "Bash(~/.claude/skills/pr-comments-flow/scripts/pr-fetch.sh)",
      "Bash(~/.claude/skills/pr-comments-flow/scripts/pr-next-comment.sh)",
      "Bash(~/.claude/skills/pr-comments-flow/scripts/pr-excerpt.sh)",
      "Bash(~/.claude/skills/pr-comments-flow/scripts/pr-reply.sh)",
      "Bash(~/.claude/skills/pr-comments-flow/scripts/pr-resolve.sh)",
      "Bash(~/.claude/skills/pr-comments-flow/scripts/pr-update-progress.sh)",
      "Bash(~/.claude/skills/pr-comments-flow/scripts/pr-progress.sh)",
      "Bash(gh pr view)",
      "Bash(git stash)",
      "Bash(git push)",
      "Bash(git pull)",
      "Bash(git diff)",
      "Bash(jq)"
    ],
    "ask": [
      "Git commit"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "php-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playground@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "context-mode@context-mode": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "language": "english",
  "alwaysThinkingEnabled": false,
  "effortLevel": "low",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "envv": {
    "ANTHROPIC_BASE_URL": "https://api.minimax.io/anthropic",
    "ANTHROPIC_AUTH_TOKEN": "sk-...",
    "ANTHROPIC_MODEL": "MiniMax-M2.7",
    "ANTHROPIC_SMALL_FAST_MODEL": "MiniMax-M2.7"
  },
  "skipWorkflowUsageWarning": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  }
}