{
  "permissions": {
    "allow": [
      "Bash(~/.claude/skills/pr-comments-flow/scripts/pr-fetch.sh)",
      "Bash(~/.claude/skills/pr-comments-flow/scripts/pr-next-comment.sh)",
      "Bash(~/.claude/skills/pr-comments-flow/scripts/pr-excerpt.sh)",
      "Bash(~/.claude/skills/pr-comments-flow/scripts/pr-reply.sh)",
      "Bash(~/.claude/skills/pr-comments-flow/scripts/pr-resolve.sh)",
      "Bash(~/.claude/skills/pr-comments-flow/scripts/pr-update-progress.sh)",
      "Bash(~/.claude/skills/pr-comments-flow/scripts/pr-progress.sh)",
      "Bash(gh pr view)",
      "Bash(git stash)",
      "Bash(git push)",
      "Bash(git pull)",
      "Bash(git diff)",
      "Bash(jq)",
      "Edit(/tmp/*)"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "php-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playground@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "caveman@caveman": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "language": "portugues-br",
  "alwaysThinkingEnabled": false,
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
