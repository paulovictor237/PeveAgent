{
  "language_models": {
    "opencode": {
      "show_zen_models": false,
    },
  },
  "diff_view_style": "unified",
  "git_panel": {
    "group_by": "staging",
    "tree_view": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "markdown_preview": {
    // "open_markdown_files_in_preview": true,
    "max_width": 1200.0,
  },
  "format_on_save": "on",
  "project_panel": {
    "auto_fold_dirs": false,
  },
  "icon_theme": {
    "mode": "light",
    "light": "Bearded Icon Theme",
    "dark": "Bearded Icon Theme",
  },
  "agent": {
    "default_model": {
      "effort": "max",
      "provider": "opencode",
      "model": "go/gpt-5.6-luna",
      "enable_thinking": true,
    },
    "sandbox_permissions": {
      "allow_all_hosts": true,
      "allow_fs_write_all": true,
    },
    "default_profile": "yolo",
    "profiles": {
      "yolo": {
        "name": "YOLO",
        "tools": {
          "write_file": true,
          "terminal": true,
          "spawn_agent": true,
          "skill": true,
          "read_file": true,
          "move_path": true,
          "list_directory": true,
          "grep": true,
          "find_path": true,
          "fetch": true,
          "edit_file": true,
          "diagnostics": true,
          "delete_path": true,
          "create_directory": true,
          "copy_path": true,
          "ask_user": true,
        },
        "enable_all_context_servers": false,
        "context_servers": {},
      },
    },
    "expand_terminal_card": false,
    "expand_edit_card": false,
    "thinking_display": "always_collapsed",
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "plan",
      },
      "type": "registry",
    },
    "antigravity-acp": {
      "default_config_options": {
        "mode": "yolo",
      },
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.6-terra",
        "mode": "agent-full-access",
        "reasoning_effort": "low",
      },
      "type": "registry",
    },
  },
}
