{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "directTools": true
    },
    "jira": {
      "type": "sse",
      "url": "https://mcp.atlassian.com/v1/sse",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "github": {
      "command": "sh",
      "args": [
        "-c",
        "GITHUB_TOKEN=$(gh auth token) exec npx -y @modelcontextprotocol/github-server"
      ]
    }
  }
}
